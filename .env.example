# Get your key from the Applitools dashboard: https://applitools.com/app/ -> top-right menu -> "My API key"
APPLITOOLS_API_KEY=your_api_key_here

# Only needed if you are on a dedicated Eyes cloud rather than the public one.
# APPLITOOLS_SERVER_URL=https://eyes.applitools.com

# Read-only key, separate from the execution key above.
# Lets Claude inspect batches/diffs via the Applitools MCP server.
# Create one at: https://eyes.applitools.com/app/admin/api-keys
APPLITOOLS_READ_KEY=your_read_key_here
